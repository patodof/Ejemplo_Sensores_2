<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/txt_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="estado : apagado"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txt_acelerometro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="acelerometro X -> 0   Y -> 0   Z -> 0"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/txt_aceleracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="aceleracion : 0"
            android:textSize="24sp" />

        <Button
            android:id="@+id/boton_iniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="iniciar sensor" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>